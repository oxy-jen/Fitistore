FLASK_APP=wsgi.py
# Local development defaults. In production, set FLASK_DEBUG=0, use a long random SECRET_KEY,
# use a persistent DATABASE_URL, and set SESSION_COOKIE_SECURE=1 behind HTTPS.
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production
DATABASE_URL=sqlite:///fity.sqlite3
ADMIN_USERNAME=owner
ADMIN_PASSWORD=replace-with-a-long-private-password
SHOP_WHATSAPP_NUMBER=25491305329
SHOP_PAYMENT_NUMBER=254141809661
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Email codes and password recovery require one working provider and a verified sender.
# On Render Free, use Brevo or Resend over HTTPS; SMTP ports are blocked.
MAIL_PROVIDER=brevo
BREVO_API_KEY=
# Optional shared token for Brevo hard-bounce and complaint suppression.
BREVO_WEBHOOK_TOKEN=
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
# Example sender only after provider verification: support@fitystore.top
MAIL_FROM_NAME=FityStores
MAIL_REPLY_TO=
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_USE_SSL=0
# Change to 1 only after the sender address/domain is verified with your provider.
# For inbox placement, publish the exact SPF and DKIM DNS records from the provider,
# add a DMARC policy for fitystore.top, and use an aligned verified From address.
# DNS authentication and sender reputation are provider/domain settings; code cannot guarantee inbox delivery.
MAIL_FROM_VERIFIED=0
MAIL_TEST_ADDRESS=
# Google Identity Services Web OAuth client ID (public client ID; no client secret is used here).
GOOGLE_CLIENT_ID=
# Canonical public HTTPS site origin used for email links and customer sign-in.
PUBLIC_BASE_URL=https://fitystore.top
# Keep 0 for local HTTP only; use 1 for production HTTPS.
SESSION_COOKIE_SECURE=0
